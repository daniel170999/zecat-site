# Cloudflare D1 is optional. Without these variables, content routes use the
# static JSON bundles in public/data/.

# Cloudflare dashboard account ID. Leave the value empty in this template.
CF_ACCOUNT_ID=

# Cloudflare dashboard > Storage & Databases > D1 > database ID.
CF_D1_DATABASE_ID=

# Cloudflare API token with Account > D1 > Edit permission.
CF_API_TOKEN=

# Session-signing key for the admin area. The admin API is disabled without it.
# Rotating this key invalidates existing sessions.
ADMIN_SECRET=

# Local test endpoint only. Leave unset in production.
CF_D1_ENDPOINT=
