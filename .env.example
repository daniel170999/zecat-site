# Cloudflare D1 - ca ba bien deu KHONG bat buoc.
# De trong het thi site van chay: moi route api tu dong fallback ve JSON bundle
# trong public/data/, chi mat phan noi dung nhap them sau nay qua D1.

# Cloudflare dashboard > goc phai trang Workers & Pages, hoac cuoi URL dashboard: dash.cloudflare.com/<ACCOUNT_ID>
CF_ACCOUNT_ID=

# Cloudflare dashboard > Storage & Databases > D1 > chon database "zecat" > muc Database ID
CF_D1_DATABASE_ID=

# Cloudflare dashboard > My Profile > API Tokens > Create Token, quyen Account > D1 > Edit
CF_API_TOKEN=

# Khoa dung de ky the phien cua khu quan tri. BAT BUOC neu muon dung khu do.
# Sinh mot cai bang: node tools/set-password.mjs
# Thieu bien nay thi khu quan tri tu tat va tra ve 503.
# Doi khoa nay se da moi nguoi dang dang nhap ra ngoai ngay lap tuc.
ADMIN_SECRET=

# Chi dung khi chay thu tai cho voi mot D1 gia. De trong o moi truong that.
CF_D1_ENDPOINT=
